generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  Int           @id @default(autoincrement())
  fullName            String
  email               String        @unique
  password            String
  role                String
  studentId           String?
  collegeName         String?
  collegeDepartment   String?
  createdAt           DateTime      @default(now())

  applications        Application[]
}

model Internship {
  id           Int           @id @default(autoincrement())
  title        String
  company      String
  description  String
  location     String
  createdAt    DateTime      @default(now())
  applications Application[]
}

model Job {
  id           Int           @id @default(autoincrement())
  title        String
  company      String
  description  String
  salary       String
  createdAt    DateTime      @default(now())
  applications Application[]
}

model Application {
  id           Int         @id @default(autoincrement())
  userId       Int
  internshipId Int?
  jobId        Int?
  createdAt    DateTime    @default(now())
  internship   Internship? @relation(fields: [internshipId], references: [id])
  job          Job?        @relation(fields: [jobId], references: [id])
  user         User        @relation(fields: [userId], references: [id])
}
